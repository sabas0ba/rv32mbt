# Fragment applied on top of nommu_virt_defconfig: switch to RV32 and
# match the rv32mbt machine (see rv32mbt.dts).
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_ARCH_RV64I is not set

# The emulator implements RV32IMA_Zicsr_Zifencei only: no compressed
# instructions, no FPU, no vector, no bit-manipulation extensions.
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBS is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# nommu_virt_defconfig forces a QEMU-virtio command line; replace it
# with ours. panic=-1 reboots immediately on panic, which reaches the
# sifive_test finisher through syscon-reboot and halts the emulator.
CONFIG_CMDLINE="earlycon=uart8250,mmio,0x10000000 console=ttyS0 panic=-1"
CONFIG_CMDLINE_FORCE=y
