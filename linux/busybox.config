# Busybox miniconfig for the rv32mbt initramfs (applied on top of
# allnoconfig via KCONFIG_ALLCONFIG). NOMMU target: applets that need
# fork are excluded; ash uses vfork + re-exec.
CONFIG_NOMMU=y
CONFIG_BUSYBOX=y
# clang constant-folds reads of the const-declared global pointers
# (write happens through a non-const alias); libbb.h documents this
# switch as the supported way to disable the trick
CONFIG_EXTRA_CFLAGS="-DBB_GLOBAL_CONST="
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LFS=y
# rcS runs `busybox --install -s` so every configured applet gets a
# real symlink; keep them in /bin and /sbin (no /usr in the image)
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_NO_USR=y

# shell: hush (ash is marked !NOMMU in busybox's Kconfig)
CONFIG_SH_IS_HUSH=y
# CONFIG_SH_IS_ASH is not set
CONFIG_HUSH=y
CONFIG_HUSH_INTERACTIVE=y
CONFIG_HUSH_JOB=y
CONFIG_HUSH_TICK=y
CONFIG_HUSH_IF=y
CONFIG_HUSH_LOOPS=y
CONFIG_HUSH_CASE=y
CONFIG_HUSH_FUNCTIONS=y
CONFIG_HUSH_LOCAL=y
CONFIG_HUSH_EXPORT=y
CONFIG_HUSH_EXPORT_N=y
CONFIG_HUSH_COMMAND=y
CONFIG_HUSH_TRAP=y
CONFIG_HUSH_TYPE=y
CONFIG_HUSH_READ=y
CONFIG_HUSH_SET=y
CONFIG_HUSH_UNSET=y
CONFIG_HUSH_WAIT=y
CONFIG_HUSH_ECHO=y
CONFIG_HUSH_PRINTF=y
CONFIG_HUSH_TEST=y
CONFIG_HUSH_KILL=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=64
CONFIG_FEATURE_SH_STANDALONE=y

# init
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y

# core utilities
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_DATE=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_FREE=y
CONFIG_GREP=y
CONFIG_HEAD=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PS=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_SLEEP=y
CONFIG_TAIL=y
CONFIG_TOUCH=y
CONFIG_UNAME=y
CONFIG_UPTIME=y
CONFIG_WC=y
CONFIG_CLEAR=y
CONFIG_DMESG=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
# inittab's shutdown entry runs `umount -a -r`
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_CTTYHACK=y

# text processing
CONFIG_SED=y
CONFIG_SORT=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_UNIQ=y
CONFIG_TEE=y
CONFIG_PRINTF=y
CONFIG_CMP=y
CONFIG_DIFF=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_FEATURE_FANCY_HEAD=y

# file and process tools
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_WHICH=y
CONFIG_ENV=y
CONFIG_STAT=y
CONFIG_READLINK=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_MKFIFO=y
CONFIG_MKNOD=y
CONFIG_SYNC=y
CONFIG_DD=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_PIDOF=y
CONFIG_TOP=y
CONFIG_ID=y
CONFIG_TTY=y
CONFIG_HOSTNAME=y
CONFIG_NPROC=y
CONFIG_SEQ=y
CONFIG_YES=y
CONFIG_EXPR=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y

# editor and pager: a real Linux userspace should have these
CONFIG_VI=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASK_TERMINAL=y
CONFIG_LESS=y
CONFIG_MORE=y

# nicer ls output (owner names and timestamps)
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_WIDTH=y

# applet options that make the above genuinely usable
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_MAXDEPTH=y
CONFIG_FEATURE_FIND_SIZE=y
CONFIG_FEATURE_FIND_NOT=y
CONFIG_FEATURE_FIND_PAREN=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_XDEV=y
CONFIG_FEATURE_SORT_BIG=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_FEATURE_DIFF_LONG_OPTIONS=y
CONFIG_FEATURE_DD_SIGNAL_HANDLING=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_TOP_DECIMALS=y
CONFIG_FEATURE_PS_TIME=y
CONFIG_FEATURE_DATE_ISOFMT=y
CONFIG_FEATURE_LESS_MAXLINES=9999999
CONFIG_FEATURE_LESS_FLAGS=y
CONFIG_FEATURE_LESS_REGEXP=y
