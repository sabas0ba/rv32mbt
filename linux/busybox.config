# Busybox miniconfig for the rv32mbt initramfs (applied on top of
# allnoconfig via KCONFIG_ALLCONFIG). NOMMU target: applets that need
# fork are excluded; ash uses vfork + re-exec.
CONFIG_NOMMU=y
CONFIG_BUSYBOX=y
# clang constant-folds reads of the const-declared global pointers
# (write happens through a non-const alias); libbb.h documents this
# switch as the supported way to disable the trick
CONFIG_EXTRA_CFLAGS="-DBB_GLOBAL_CONST="
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LFS=y

# shell: hush (ash is marked !NOMMU in busybox's Kconfig)
CONFIG_SH_IS_HUSH=y
# CONFIG_SH_IS_ASH is not set
CONFIG_HUSH=y
CONFIG_HUSH_INTERACTIVE=y
CONFIG_HUSH_JOB=y
CONFIG_HUSH_TICK=y
CONFIG_HUSH_IF=y
CONFIG_HUSH_LOOPS=y
CONFIG_HUSH_CASE=y
CONFIG_HUSH_FUNCTIONS=y
CONFIG_HUSH_LOCAL=y
CONFIG_HUSH_EXPORT=y
CONFIG_HUSH_EXPORT_N=y
CONFIG_HUSH_COMMAND=y
CONFIG_HUSH_TRAP=y
CONFIG_HUSH_TYPE=y
CONFIG_HUSH_READ=y
CONFIG_HUSH_SET=y
CONFIG_HUSH_UNSET=y
CONFIG_HUSH_WAIT=y
CONFIG_HUSH_ECHO=y
CONFIG_HUSH_PRINTF=y
CONFIG_HUSH_TEST=y
CONFIG_HUSH_KILL=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=64
CONFIG_FEATURE_SH_STANDALONE=y

# init
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y

# core utilities
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_DATE=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_FREE=y
CONFIG_GREP=y
CONFIG_HEAD=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PS=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_SLEEP=y
CONFIG_TAIL=y
CONFIG_TOUCH=y
CONFIG_UNAME=y
CONFIG_UPTIME=y
CONFIG_WC=y
CONFIG_CLEAR=y
CONFIG_DMESG=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
# inittab's shutdown entry runs `umount -a -r`
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_CTTYHACK=y
