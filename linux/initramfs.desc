dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /etc 0755 0 0
dir /etc/init.d 0755 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 1777 0 0
dir /root 0700 0 0
file /bin/busybox /work/_build/kernel/busybox 0755 0 0
slink /bin/sh busybox 0777 0 0
slink /init /bin/busybox 0777 0 0
file /etc/inittab /work/linux/inittab 0644 0 0
file /etc/init.d/rcS /work/linux/rcS 0755 0 0
file /bin/mini /work/_build/kernel/init 0755 0 0
# tests/examples/ built against musl for the Linux target: the same
# sources as the bare-metal samples, so their output must match the
# committed .expect files here too (see tests/examples/build_linux.sh)
dir /opt 0755 0 0
dir /opt/examples 0755 0 0
file /opt/examples/hello_c /work/_build/kernel/examples/hello_c 0755 0 0
file /opt/examples/fib /work/_build/kernel/examples/fib 0755 0 0
file /opt/examples/lifegame /work/_build/kernel/examples/lifegame 0755 0 0
file /opt/examples/mandelbrot /work/_build/kernel/examples/mandelbrot 0755 0 0
file /opt/examples/primes /work/_build/kernel/examples/primes 0755 0 0
# The emulator, as a wasm module, plus the interpreter that runs it
# and a program to run inside it: the guest can emulate the machine it
# is itself running on (see tools/wasmrun/).
dir /opt/nested 0755 0 0
file /opt/nested/wasmrun /work/_build/kernel/wasmrun 0755 0 0
file /opt/nested/rv32mbt.wasm /work/_build/kernel/rv32mbt.wasm 0644 0 0
file /opt/nested/hello.elf /work/_build/kernel/hello.elf 0644 0 0
