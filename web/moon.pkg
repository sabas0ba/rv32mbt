import {
  "sabas0ba/rv32mbt/core",
}

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "vm_create",
        "vm_load_elf",
        "vm_load_bin",
        "vm_load_dtb",
        "vm_run",
        "vm_halted",
        "vm_exit_code",
        "vm_pc",
        "vm_push_input",
        "vm_take_output",
        "vm_step",
        "vm_reg",
        "vm_peek",
        "vm_csr",
        "vm_set_trace",
        "vm_take_trace",
      ],
      "format": "esm",
    },
  },
)
